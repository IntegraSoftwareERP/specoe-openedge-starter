{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node $HOME/.claude/hooks/specoe-license-check.mjs",
            "timeout": 5,
            "shell": "bash"
          },
          {
            "type": "command",
            "command": "node $HOME/.claude/hooks/specoe-role-check.mjs",
            "timeout": 5,
            "shell": "bash"
          },
          {
            "type": "command",
            "command": "node $HOME/.claude/hooks/specoe-room-bootstrap.mjs",
            "timeout": 15,
            "shell": "bash"
          }
        ]
      }
    ]
  },
  "env": {
    "CLAUDE_CODE_ENABLE_TELEMETRY": "1",
    "NODE_EXTRA_CA_CERTS": "${env:USERPROFILE}/.claude/caddy-local-root.crt"
  },
  "permissions": {
    "allow": [
      "Read(**)",
      "Grep(**)",
      "Glob(**)",
      "Bash(git status)",
      "Bash(git log *)",
      "Bash(git diff *)",
      "Bash(git show *)",
      "Bash(npm test *)",
      "Bash(npx *)",
      "Bash(docker compose *)"
    ]
  }
}
